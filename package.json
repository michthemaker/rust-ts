  "repository": {
    "type": "git",
    "url": "git+https://github.com/michthemaker/rust-ts.git",
    "directory": "."
  },
  "files": [
    "./lib",
    "./src",
    "./README.md",
    "./.gitignore",
    "./package.json",
    "./tsconfig.json"
  ],
