    "./default": "./src/default.ts",
    "./fmt": "./src/fmt.ts",
    "./globals": "./src/globals.ts",
    "./inspect": "./src/inspect.ts",
    "./lang": "./src/lang/index.ts",
    "./macro": "./src/macro/index.ts",
    "./num": "./src/num.ts",
    "./option": "./src/option.ts",
    "./primitive": "./src/primitive/index.ts",
    "./range": "./src/range.ts",
    "./result": "./src/result.ts",
    "./sync/mpmc": "./src/sync/mpmc.ts",
    "./sync/mpsc": "./src/sync/mpsc.ts",
    "./sync/once_lock": "./src/sync/once_lock.ts",
    "./sync/semaphore": "./src/sync/semaphore.ts",
    "./thread": "./src/thread/index.ts",
    "./thread/serializable": "./src/thread/serializable.ts",
    "./thread/shared_json_buffer": "./src/thread/shared_json_buffer.ts",
